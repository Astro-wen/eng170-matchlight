# Real photo analysis. Server-side runtime only; never use NEXT_PUBLIC_ keys.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
MATCHLIGHT_VISION_MODEL=google/gemini-3-flash-preview
MATCHLIGHT_ANALYSIS_MODEL=google/gemini-3-flash-preview
MATCHLIGHT_JEV_MODEL=jev-latest

# Optional model-written explanations. Leave blank for the working grounded demo.
# Copy this file to .env.local for local development. Never commit actual secrets.
MATCHLIGHT_AI_API_KEY=
MATCHLIGHT_AI_MODEL=
MATCHLIGHT_AI_BASE_URL=https://api.openai.com/v1

# OPENAI_API_KEY is also accepted as the key when MATCHLIGHT_AI_API_KEY is empty.
# The model must support Chat Completions and strict JSON Schema output.
